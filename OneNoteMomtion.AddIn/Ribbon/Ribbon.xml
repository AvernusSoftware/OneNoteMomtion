<?xml version="1.0" encoding="utf-8"?>
<!-- Labels and tips come from OneNoteMomtion.Core/Localization/*.json (keys "ribbon.<id>.label", ".screentip",
     ".supertip"), embedded in the add-in, so the interface language follows styles.json without reinstalling. The tab
     install.ps1 puts on the ribbon references these groups by idQ, which is why their labels follow too. -->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <tab id="OneNoteMomtionCommands" label="OneNoteMomtion">

        <group id="grpStyles" getLabel="OnGetLabel">
          <button id="styleHeading1" getLabel="OnGetLabel" tag="style.heading1" onAction="OnCommand" imageMso="StyleGalleryClassic"
                  getScreentip="OnGetScreentip" getSupertip="OnGetSupertip" />
          <button id="styleHeading2" getLabel="OnGetLabel" tag="style.heading2" onAction="OnCommand" imageMso="StyleGalleryClassic"
                  getScreentip="OnGetScreentip" getSupertip="OnGetSupertip" />
          <button id="styleHeading3" getLabel="OnGetLabel" tag="style.heading3" onAction="OnCommand" imageMso="StyleGalleryClassic"
                  getScreentip="OnGetScreentip" getSupertip="OnGetSupertip" />
          <button id="styleNormal" getLabel="OnGetLabel" tag="style.normal" onAction="OnCommand" imageMso="StyleGalleryClassic"
                  getScreentip="OnGetScreentip" getSupertip="OnGetSupertip" />
        </group>

        <group id="grpNavigation" getLabel="OnGetLabel">
          <button id="navCollapseAll" getLabel="OnGetLabel" tag="nav.collapseAll" onAction="OnCommand" imageMso="OutlineCollapse"
                  getScreentip="OnGetScreentip" getSupertip="OnGetSupertip" />
        </group>

        <group id="grpCode" getLabel="OnGetLabel">
          <dynamicMenu id="languageMenu" getLabel="OnGetLabel"
                       getContent="OnLanguageMenuContent"
                       imageMso="SetLanguageDialog"
                       getScreentip="OnGetScreentip" getSupertip="OnGetSupertip" />
        </group>

        <group id="grpTextCase" getLabel="OnGetLabel">
          <button id="caseUpper" getLabel="OnGetLabel" tag="case.upper" onAction="OnCommand" imageMso="ChangeCase" />
          <button id="caseLower" getLabel="OnGetLabel" tag="case.lower" onAction="OnCommand" imageMso="ChangeCase" />
          <button id="caseCapitalize" getLabel="OnGetLabel" tag="case.capitalize" onAction="OnCommand" imageMso="ChangeCase" />
          <button id="caseSentence" getLabel="OnGetLabel" tag="case.sentence" onAction="OnCommand" imageMso="ChangeCase" />
          <button id="caseToggle" getLabel="OnGetLabel" tag="case.toggle" onAction="OnCommand" imageMso="ChangeCase" />
        </group>

        <group id="grpTools" getLabel="OnGetLabel">
          <button id="spellDisable" getLabel="OnGetLabel" tag="spell.disable" onAction="OnCommand" imageMso="SpellingAndGrammar"
                  getScreentip="OnGetScreentip" getSupertip="OnGetSupertip" />
          <button id="spellEnable" getLabel="OnGetLabel" tag="spell.enable" onAction="OnCommand" imageMso="SpellingAndGrammar"
                  getScreentip="OnGetScreentip" getSupertip="OnGetSupertip" />
          <button id="navReveal" getLabel="OnGetLabel" tag="nav.reveal" onAction="OnCommand" imageMso="FindDialog"
                  getScreentip="OnGetScreentip" getSupertip="OnGetSupertip" />
          <button id="pageReformat" getLabel="OnGetLabel" tag="page.reformat" onAction="OnCommand" imageMso="TableAutoFormat"
                  getScreentip="OnGetScreentip" getSupertip="OnGetSupertip" />
          <button id="settingsOpen" getLabel="OnGetLabel" tag="settings.open" onAction="OnCommand" imageMso="ApplicationOptionsDialog"
                  getScreentip="OnGetScreentip" getSupertip="OnGetSupertip" />
        </group>

      </tab>
    </tabs>
  </ribbon>
</customUI>
